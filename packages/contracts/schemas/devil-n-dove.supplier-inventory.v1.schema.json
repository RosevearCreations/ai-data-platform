{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rosevear.ai/contracts/devil-n-dove.supplier-inventory.v1.schema.json",
  "title": "devil-n-dove.supplier-inventory.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "schemaId",
    "target",
    "adapterContract",
    "contractVersion",
    "packageId",
    "replayKey",
    "batchId",
    "approvedAt",
    "sourceDatasetUpdatedAt",
    "generatedAt",
    "expiresAt",
    "fingerprint",
    "operations"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "schemaId": {
      "const": "https://rosevear.ai/contracts/devil-n-dove.supplier-inventory.v1.schema.json"
    },
    "target": {
      "const": "devil-n-dove"
    },
    "adapterContract": {
      "const": "devil-n-dove.supplier-inventory.v1"
    },
    "contractVersion": {
      "const": 1
    },
    "packageId": {
      "type": "string",
      "minLength": 1
    },
    "replayKey": {
      "type": "string",
      "minLength": 1
    },
    "batchId": {
      "type": "string",
      "minLength": 1
    },
    "approvedAt": {
      "type": "string",
      "format": "date-time"
    },
    "sourceDatasetUpdatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    },
    "fingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}$"
    },
    "operations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "action",
          "integrationKey",
          "values",
          "sourceEvidence"
        ],
        "properties": {
          "action": {
            "enum": [
              "create",
              "update"
            ]
          },
          "integrationKey": {
            "type": "string",
            "pattern": "^devil-supplier::"
          },
          "values": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "supplierName": {
                "type": [
                  "string",
                  "number",
                  "boolean",
                  "null"
                ]
              },
              "productName": {
                "type": [
                  "string",
                  "number",
                  "boolean",
                  "null"
                ]
              },
              "supplierSku": {
                "type": [
                  "string",
                  "number",
                  "boolean",
                  "null"
                ]
              },
              "supplierImageUrl": {
                "type": [
                  "string",
                  "number",
                  "boolean",
                  "null"
                ]
              },
              "packagePriceCad": {
                "type": [
                  "string",
                  "number",
                  "boolean",
                  "null"
                ]
              },
              "packageQuantity": {
                "type": [
                  "string",
                  "number",
                  "boolean",
                  "null"
                ]
              },
              "stockUnit": {
                "type": [
                  "string",
                  "number",
                  "boolean",
                  "null"
                ]
              },
              "usageUnit": {
                "type": [
                  "string",
                  "number",
                  "boolean",
                  "null"
                ]
              },
              "usageUnitsPerStockUnit": {
                "type": [
                  "string",
                  "number",
                  "boolean",
                  "null"
                ]
              },
              "totalUsageUnits": {
                "type": [
                  "string",
                  "number",
                  "boolean",
                  "null"
                ]
              },
              "costPerStockUnitCad": {
                "type": [
                  "string",
                  "number",
                  "boolean",
                  "null"
                ]
              },
              "costPerUsageUnitCad": {
                "type": [
                  "string",
                  "number",
                  "boolean",
                  "null"
                ]
              },
              "sourceUrl": {
                "type": [
                  "string",
                  "number",
                  "boolean",
                  "null"
                ]
              },
              "sourceScope": {
                "type": [
                  "string",
                  "number",
                  "boolean",
                  "null"
                ]
              },
              "retrievedAt": {
                "type": [
                  "string",
                  "number",
                  "boolean",
                  "null"
                ]
              }
            }
          },
          "sourceEvidence": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "sourceUrl",
              "retrievedAt"
            ],
            "properties": {
              "sourceUrl": {
                "type": "string",
                "pattern": "^https?://"
              },
              "retrievedAt": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        }
      }
    }
  }
}
