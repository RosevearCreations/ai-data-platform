{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rosevear.ai/contracts/rosevear.master-shell.registry-record.v1.schema.json",
  "title": "Rosevear Master Shell Registry Record V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sourceId",
    "repository",
    "environment",
    "shellBoundary",
    "productOwner",
    "manifestURI",
    "immutableRevision",
    "capabilityVersion",
    "contractVersion",
    "approvedOrigin",
    "signerKeyId",
    "signerFingerprint",
    "status",
    "statusObservedAt",
    "statusExpiresAt",
    "lastVerifiedEvidenceURI",
    "rolesAllowed",
    "tenancyModel"
  ],
  "properties": {
    "sourceId": {
      "enum": [
        "yw",
        "icamp",
        "rosiedazzlers",
        "devilndove",
        "ai-data-platform",
        "rosevear-ai-hub"
      ]
    },
    "repository": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "environment": {
      "enum": [
        "nonproduction",
        "production"
      ]
    },
    "shellBoundary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "productOwner": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "manifestURI": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "immutableRevision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "capabilityVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "contractVersion": {
      "const": "1.0.0"
    },
    "approvedOrigin": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "signerKeyId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "signerFingerprint": {
      "type": "string",
      "minLength": 16,
      "maxLength": 256
    },
    "status": {
      "enum": [
        "UNKNOWN",
        "DISCOVERED",
        "CONFIGURED",
        "AUTHORIZATION_HELD",
        "TEST_VERIFIED",
        "CONNECTED",
        "STALE",
        "DEGRADED",
        "DISCONNECTED",
        "REVOKED",
        "ERROR"
      ]
    },
    "statusObservedAt": {
      "type": "string",
      "format": "date-time"
    },
    "statusExpiresAt": {
      "type": "string",
      "format": "date-time"
    },
    "lastVerifiedEvidenceURI": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "rolesAllowed": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      }
    },
    "tenancyModel": {
      "enum": [
        "platform-shell-with-child-tenants",
        "owned-business-shell",
        "support-broker-no-customer-tenant",
        "local-support-server"
      ]
    }
  }
}
