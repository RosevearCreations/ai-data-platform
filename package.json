{
  "name": "@rosevear/ai-data-platform",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "pnpm -r --if-present lint",
    "test": "pnpm -r --if-present test",
    "verify": "pnpm ci:promotion",
    "ci:promotion": "node apps/web/scripts/ci-suite-runner.mjs promotion",
    "ci:legacy": "node apps/web/scripts/ci-suite-runner.mjs legacy"
  }
}
