{
  "schema": "rosevear.ai-data-platform.build427-seven-source-credential-activation.v1",
  "build": 427,
  "title": "Seven-Source Credential Enrollment, Signed Live Telemetry Activation, Continuous Statistical Rollups & Master Health Dashboard",
  "applications": [
    "ai-data-platform",
    "rosevear-ai-hub",
    "rosevear-comms-hub",
    "icamp",
    "yw",
    "devilndove",
    "rosiedazzlers"
  ],
  "credentialCustody": {
    "storage": "server environment references only",
    "secretValuesPersisted": false,
    "sourcePrivateKeysStoredByAIDP": false
  },
  "activationRule": [
    "credential present",
    "HTTPS origin reachable",
    "telemetry envelope admitted",
    "source commit pin exact",
    "Ed25519 signature valid",
    "freshness and anti-replay valid"
  ],
  "rollups": {
    "bucketMinutes": 15,
    "historyDays": 7,
    "autonomousHeartbeat": "daily Vercel cron floor plus operator-triggered sweeps"
  },
  "policy": {
    "productionGreenMayImplySevenSourceConnected": false,
    "missingCredentialMayPass": false,
    "reachableOriginMayPass": false,
    "telemetryAuthorizesAction": false
  }
}
